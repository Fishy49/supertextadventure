<div id="player_inventory_<%= user.id %>" class="mb-5">
  <% inventory = game.player_state(user.id)["inventory"] || [] %>
  <p class="text-terminal-green font-bold mb-2 border-b border-terminal-green pb-1">
    Inventory :: <%= inventory.size %> item<%= inventory.size == 1 ? "" : "s" %>
  </p>
  <% if inventory.empty? %>
    <p class="text-center opacity-60 italic">(empty)</p>
  <% else %>
    <ul class="list-none p-0 m-0"
        data-controller="inventory"
        data-inventory-single-open-value="true">
      <% inventory.each_with_index do |item_id, index| %>
        <% item_def = game.world_snapshot.dig("items", item_id) || { "name" => item_id } %>
        <%= render "games/inventory_item", item_id: item_id, item_def: item_def, index: index %>
      <% end %>
    </ul>
  <% end %>
</div>
