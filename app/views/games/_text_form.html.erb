<div id="text_form_content">
  <% in_limbo = game.game_state.dig("player_states", user.id.to_s, "waiting_for_combat_end") %>
  <% order = game.turn_state["turn_order"] || [] %>
  <% benched = order.any? && !order.include?(user.id) && game.game_state.dig("player_states", user.id.to_s).present? %>
  <% if game.in_combat? %>
    <% on_turn = !in_limbo && game.current_combat_user_id == user.id %>
  <% else %>
    <% on_turn = !in_limbo && !benched && (order.length <= 1 || order.empty? || game.current_turn_user_id == user.id) %>
  <% end %>

  <div class="<%= 'hidden' unless on_turn %>">
    <%= render(TerminalInputComponent.new(
      prompt: "",
      stimulus_controllers: ["game"],
      stimulus_values: {
        "game-id": game.id,
        "game-user-id": game.game_user(user)&.id || (game.host?(user) ? :host : nil),
        "game-game-type": game.game_type
      }
    )) %>
  </div>

  <% unless on_turn %>
    <div class="italic opacity-70 py-2">
      <% if in_limbo %>
        Waiting for combat to finish...
      <% elsif benched && !game.in_combat? %>
        You're out of the turn rotation. The host can add you back in.
      <% elsif game.in_combat? %>
        <% current = game.current_combatant %>
        <% if current && current["type"] == "creature" %>
          <% creature_name = game.world_snapshot.dig("creatures", current["id"], "name") || current["id"] %>
          The <%= creature_name %> is taking its turn...
        <% elsif current %>
          <% name = game.character_name_for(current["id"].to_i) || "another player" %>
          Waiting for <%= name %>'s combat turn...
        <% end %>
      <% else %>
        <% current_name = game.character_name_for(game.current_turn_user_id) || "another player" %>
        Waiting for <%= current_name %>...
      <% end %>
    </div>
  <% end %>
</div>
