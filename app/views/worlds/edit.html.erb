<div class="wb-host"
     data-controller="world-builder"
     data-world-builder-save-url-value="<%= world_path(@world) %>"
     data-world-builder-world-id-value="<%= @world.id %>"></div>

<script type="application/json" id="wb-world"><%= builder_json(@world.world_data) %></script>
<script type="application/json" id="wb-schema"><%= builder_json(ClassicGame::WorldValidator.schema_document) %></script>
<script type="application/json" id="wb-refs"><%= builder_json(ClassicGame::WorldValidator.refs_document) %></script>
<script type="application/json" id="wb-samples"><%= builder_json(ClassicGame::SampleWorlds.all) %></script>
